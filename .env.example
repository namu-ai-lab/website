# Copy to .env.local for development; set the same names in Vercel (Project → Settings → Environment Variables).
# The public pages build and run without any of these; accounts and the live demos switch on when they are set.
# A feature set up in part (accounts without NAMU_KEY_PEPPER, one half of the proxy token) stops a production build;
# the dev server reports it. The check is src/lib/env-check.ts.
# `npm run env:init` fills in NEON_AUTH_COOKIE_SECRET and NAMU_KEY_PEPPER for you.

# Neon (console.neon.tech → your project → Connect → pooled connection string). Server-only.
DATABASE_URL=

# Sign-in (Neon Auth). Server-only. The Auth URL is in the Neon Console → Auth → Configuration; the cookie secret
# signs this site's session cookies (32 characters or more; use a different one per environment).
# Email and password, Google and GitHub, email verification and the trusted domains (localhost, the production and
# preview hosts) are all set in the Neon Console, not here.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Which social buttons to show; match what is switched on in Neon. Default "google,github"; empty for none.
NEON_AUTH_PROVIDERS=google,github

# Server-only. Must equal the Modal secret `namu-key-pepper`. Changing it later invalidates every API key.
NAMU_KEY_PEPPER=

# Server-only. A normal API key created in the dashboard, then marked as the demo key (`npm run db:admin -- --demo`).
NAMU_DEMO_KEY=

# Server-only. The website's service key for the console Playground (`npm run db:admin -- --service` creates it and
# saves it here). It acts only for a signed-in account, so Playground runs count on that developer's allowance.
NAMU_SERVICE_KEY=

# Server-only. Aïr's agent service, which the home page's live conversation calls for its text step
# (src/app/api/demo/converse). Defaults to the agent deployed on Namu's Modal workspace.
NAMU_AGENT_URL=

# Server-only. A Modal proxy-auth token (Modal dashboard → Settings → Proxy auth tokens): the same two values as the
# `namu-proxy-auth` Modal secret. The model services refuse every request without it, so the home page's conversation
# needs both, in Vercel Production and Preview, before namu-agent is deployed locked. Never in browser code.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Server-only. WhatsApp for Namu Agents (Meta's WhatsApp Cloud API): it is on once all three are set, and off (the
# webhook refuses every message) while any is missing; a half-set WhatsApp is reported, never a failed build. WHATSAPP_TOKEN is a system
# user's token with whatsapp_business_messaging; WHATSAPP_APP_SECRET is the Meta app's secret (it signs every webhook
# call); WHATSAPP_VERIFY_TOKEN is any long word, entered in Meta's webhook settings with the callback URL
# https://<site>/api/agents/whatsapp. A Namu admin binds each agent's phone number id on its WhatsApp tab.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# The public API base developers call. Defaults to the Modal gateway URL.
# The gateway deployed on Namu's own Modal workspace (https://<workspace>--namu-gateway-api.modal.run), until api.namu-ai.org points at it.
NEXT_PUBLIC_NAMU_API_BASE=

# Written by `npm run db:migrate`: the gateway's restricted database login. Goes to Modal (`npm run modal:secrets`), not Vercel.
GATEWAY_DATABASE_URL=
