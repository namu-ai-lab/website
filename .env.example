# Copy to .env.local for development; set the same names in Vercel (Project → Settings → Environment Variables).
# The public pages build and run without any of these; accounts and the live demos switch on when they are set.
# `npm run env:init` fills in BETTER_AUTH_SECRET, NAMU_KEY_PEPPER and BETTER_AUTH_URL for you.

# Neon (console.neon.tech → your project → Connect → pooled connection string). Server-only.
DATABASE_URL=

# Sign-in sessions (Better Auth). Server-only. BETTER_AUTH_URL is the site's own URL; leave it unset on Vercel,
# where previews and production work it out themselves.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign-in providers: set at least one pair. Callback URL to register: <site>/api/auth/callback/github (or /google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only. Must equal the Modal secret `namu-key-pepper`. Changing it later invalidates every API key.
NAMU_KEY_PEPPER=

# Server-only. A normal API key created in the dashboard, then marked as the demo key (`npm run db:admin -- --demo`).
NAMU_DEMO_KEY=

# The public API base developers call. Defaults to the Modal gateway URL.
NEXT_PUBLIC_NAMU_API_BASE=https://abdoulide71--namu-gateway-api.modal.run

# Written by `npm run db:migrate`: the gateway's restricted database login. Goes to Modal (`npm run modal:secrets`), not Vercel.
GATEWAY_DATABASE_URL=
